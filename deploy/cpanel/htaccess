# garudanexa.com di cPanel (LiteSpeed/Apache). Disalin ke public_html/.htaccess oleh scripts/deploy-cpanel.mjs.
# Blok handler PHP harus tetap di AKHIR file: cPanel (MultiPHP) menulis ulang blok itu ke akhir .htaccess. Kalau
# posisinya beda, file di server dianggap berubah dan "Update from Remote" ditolak git.

Options -Indexes
DirectoryIndex index.html

# Video latar hero (assets/bg/hero_video_*, diunggah lewat api.php?action=upload_hero_video)
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Paksa HTTPS (kecuali validasi AutoSSL)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # File sensitif tidak boleh diakses dari web
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sql|sh|log|ya?ml|md|lock|ini)$ - [F,L]
  RewriteRule ^modules/ - [F,L]

  # Dokumen proyek klien hanya lewat api.php?action=download_project_file (staf yang login).
  # Gambar proyek di assets/dokumen-client/logo/ tetap publik (beranda).
  RewriteRule ^/*assets/+dokumen-client/+dokumen(/|$) - [F,L,NC]

  # Frontend memanggil /api/ai-chat (jalur Node); di PHP itu action=ai_chat
  RewriteRule ^api/ai-chat/?$ api.php?action=ai_chat [QSA,L]

  # Aplikasi satu halaman (React Router): rute yang bukan file/folder → index.html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

  # index.html selalu dicek ulang; file build bernama hash boleh disimpan lama
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  # Nama video hero acak per unggahan (hero_video_<hex>), jadi boleh disimpan lama
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
</IfModule>

# Batas upload untuk api.php (gambar & dokumen dikirim base64, video hero sebagai body mentah:
# UPLOAD_MAX_VIDEO_MB di .env harus di bawah post_max_size)
<IfModule mod_php.c>
  php_value post_max_size 64M
  php_value upload_max_filesize 32M
  php_value memory_limit 256M
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

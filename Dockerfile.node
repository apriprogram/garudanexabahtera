FROM node:22-alpine

# Set UID/GID 1000 for node user (already exists in alpine)
WORKDIR /app

# Ensure we have the target directory for volumes
USER root
RUN mkdir -p /var/www/html && chown -R node:node /var/www/html

# Install deps
COPY package*.json ./
RUN npm install

# Copy source
COPY . .
RUN chown -R node:node /app

USER node
EXPOSE 4000
CMD ["node", "server.js"]

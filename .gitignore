# Database dumps from backup.sh — they contain production data
backups/
db_backup_*.sql

# Local-only seed files (test accounts with plaintext passwords) — never commit
database/*.local.sql

# Build & worktree untuk deploy cPanel (scripts/deploy-cpanel.mjs)
.deploy/

# Upload konten situs pembeli (CMS) dari dev lokal: hanya ada di server, jangan di-commit
public/assets/sites/

# Video & poster latar hero yang diunggah dari admin (api.php lokal), termasuk file sementara .hero_video_*.part:
# hanya di server/disk lokal, jangan di-commit. Gambar slider bawaan di public/assets/bg/ tetap ter-track.
public/assets/bg/hero_video_*
public/assets/bg/hero_poster_*
public/assets/bg/.hero_video_*
# Gambar latar hero yang diunggah dari admin saat uji lokal (hero_<12 hex>.<ext>): konten, bukan kode. Gambar bawaan
# hero_6a07…_N.jpg, hero.png, hero1.png, hero2.png tetap terlacak.
public/assets/bg/hero_????????????.*

# Dokumen & logo klien (upload dari admin): tetap di server/disk lokal, jangan masuk repo publik.
# File lama yang sudah ter-track tidak ikut terhapus oleh aturan ini.
public/assets/dokumen-client/

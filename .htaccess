# garudanexa.com di cPanel (LiteSpeed/Apache). Disalin ke public_html/.htaccess oleh scripts/deploy-cpanel.mjs.
# Blok handler PHP harus tetap di AKHIR file: cPanel (MultiPHP) menulis ulang blok itu ke akhir .htaccess. Kalau
# posisinya beda, file di server dianggap berubah dan "Update from Remote" ditolak git.

Options -Indexes
DirectoryIndex index.html

# Video latar hero (assets/bg/hero_video_*, diunggah lewat api.php?action=upload_hero_video)
<IfModule mod_mime.c>
  AddType video/mp4 .mp4
  AddType video/webm .webm
  # llms.txt / llms-full.txt (dan robots.txt) berbahasa Indonesia: UTF-8 eksplisit
  AddType "text/plain; charset=utf-8" .txt
  # site.webmanifest (ikon PWA, WP3): tidak semua server mengenal ekstensinya
  AddType application/manifest+json .webmanifest
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Satu host kanonis: www → https://garudanexa.com dalam satu lompatan. Harus SEBELUM aturan HTTPS, supaya
  # http://www tidak lewat https://www dulu. Validasi AutoSSL (/.well-known/) tetap dilayani di host www.
  RewriteCond %{HTTP_HOST} ^www\.garudanexa\.com$ [NC]
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://garudanexa.com%{REQUEST_URI} [R=301,L]

  # Paksa HTTPS (kecuali validasi AutoSSL)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !=https
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # /index.html → / (host utama saja). THE_REQUEST = baris request asli dari browser, jadi rewrite internal ke
  # index.html (aturan SPA di bawah, DirectoryIndex) tidak ikut dialihkan dan tidak berputar. Tujuan ditulis lengkap
  # dengan https: di belakang proxy koneksi ke server bisa http, dan "/" saja akan jadi http://garudanexa.com/.
  RewriteCond %{HTTP_HOST} ^garudanexa\.com$ [NC]
  RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
  RewriteRule ^index\.html$ https://garudanexa.com/ [R=301,L]

  # File sensitif tidak boleh diakses dari web
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule \.(sql|sh|log|ya?ml|md|lock|ini)$ - [F,L]
  RewriteRule ^modules/ - [F,L]

  # Dokumen proyek klien hanya lewat api.php?action=download_project_file (staf yang login).
  # Gambar proyek di assets/dokumen-client/logo/ tetap publik (beranda).
  RewriteRule ^/*assets/+dokumen-client/+dokumen(/|$) - [F,L,NC]

  # File internal hasil prerender tidak bisa dibuka langsung (semua host): _pre/ dan app.html hanya dipakai lewat
  # rewrite di bawah. THE_REQUEST = baris request asli dari browser, jadi rewrite internal ke file-file ini tidak ikut
  # tertolak (di Apache maupun LiteSpeed). Request dengan %-encoding di path (/%5Fpre/index.html, /app%2Ehtml): THE_REQUEST
  # belum di-decode, jadi cukup berisi "%" dan pola RewriteRule mencocokkan path yang sudah di-decode; rewrite internal
  # ke _pre/ (request tanpa "%") tetap jalan.
  # Jawabannya 404 dari seo.php (isi 404.html), bukan R=404 + ErrorDocument. Di koneksi keep-alive LiteSpeed memakai
  # ulang file statis hasil rewrite internal sebelumnya tanpa menjalankan aturan ini: sesudah ErrorDocument /404.html,
  # /404.html langsung dijawab 200 dan 404 berikutnya 200 berisi halaman 404. seo.php dijalankan ulang, jadi aman. Sisa
  # yang sama: /app.html atau /_pre/x.html langsung tepat sesudah rute yang di-rewrite ke file itu bisa 200 (tidak
  # ditautkan; app.html noindex, _pre/ ber-canonical ke URL aslinya). Pola RewriteRule = path saat ini, jadi putaran kedua
  # (path seo.php) tidak cocok lagi.
  # seo.php sendiri menolak dibuka langsung (404, dicek di seo.php). /_pre tanpa garis miring = folder nyata: rewrite ke
  # seo.php di situ dijawab mod_dir dengan 301 ke /_pre/?gn404=1, jadi langsung 403.
  RewriteCond %{THE_REQUEST} \s/+_pre[?\s] [NC,OR]
  RewriteCond %{THE_REQUEST} ^\S+\s+[^?\s]*%
  RewriteRule ^/*_pre$ - [F,L,NC]
  RewriteCond %{THE_REQUEST} \s/+(_pre([/?\s]|$)|app\.html) [NC,OR]
  RewriteCond %{THE_REQUEST} ^\S+\s+[^?\s]*%
  RewriteRule ^/*(_pre(/|$)|app\.html$) seo.php?gn404=1 [L,NC]
  # 404.html (isi halaman 404 yang dikirim seo.php) dibuka langsung → 410 (Gone) dengan halaman bawaan server. Tanpa
  # cek REDIRECT_STATUS: aturan 404 di sini tidak lagi membuka 404.html lewat ErrorDocument.
  RewriteCond %{THE_REQUEST} \s/+404\.html[\s?] [NC,OR]
  RewriteCond %{THE_REQUEST} ^\S+\s+[^?\s]*%
  RewriteRule ^/*404\.html$ - [G,L,NC]

  # Frontend memanggil /api/ai-chat (jalur Node); di PHP itu action=ai_chat. Sebelum aturan garis miring di bawah,
  # supaya POST ke /api/ai-chat/ tidak dialihkan.
  RewriteRule ^api/ai-chat/?$ api.php?action=ai_chat [QSA,L]

  # ── Host utama garudanexa.com (docs/platform/SEO-PLAN.md §5.2). Domain pembeli tidak terkena aturan ini. ──

  # Garis miring di akhir → tanpa garis miring (301, satu lompatan), kecuali folder nyata (assets/, …)
  RewriteCond %{HTTP_HOST} ^garudanexa\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+?)/+$ https://garudanexa.com/$1 [R=301,L]

  # Halaman hasil prerender: / → _pre/index.html, /template/finova → _pre/template/finova.html. Daftar rutenya ditulis
  # scripts/prerender.mjs saat build (tanpa cek -f ke %{DOCUMENT_ROOT}, yang bisa berbeda di cPanel/LiteSpeed).
  # BEGIN gn-prerender (diisi scripts/prerender.mjs: 26 halaman)
  RewriteCond %{HTTP_HOST} ^garudanexa\.com$ [NC]
  RewriteRule ^$ _pre/index.html [L]
  RewriteCond %{HTTP_HOST} ^garudanexa\.com$ [NC]
  RewriteRule ^(harga|jasa-pembuatan-aplikasi-mobile|jasa-pembuatan-website|kebijakan-pengembalian-dana|kebijakan-privasi|kontak|panduan|panduan/biaya-aplikasi-android-ios|panduan/biaya-website-company-profile|panduan/template-vs-jasa-website-custom|panduan/website-klinik-kecantikan|pesan-custom|syarat-ketentuan|template|template/arena-club|template/aura-studio|template/corporate-nexa|template/finova|template/kategori/company-profile|template/kategori/fintech-startup|template/kategori/kecantikan-klinik|template/kategori/olahraga-komunitas|template/serenity|template/startup-clean|tentang)$ _pre/$1.html [L]
  # END gn-prerender

  # Template yang terbit setelah deploy terakhir: seo.php merender halamannya dari DB, atau 404 bila tidak ada /
  # belum terbit. Template yang sudah diprerender tertangkap aturan di atas lebih dulu. Batas 120 karakter = batas slug
  # di kedua backend dan kolom templates.slug (dicek __tests__/backend/template-slug.test.ts).
  RewriteCond %{HTTP_HOST} ^garudanexa\.com$ [NC]
  RewriteRule ^template/([a-z0-9-]{1,120})$ seo.php?slug=$1 [L]

  # Artikel panduan yang terbit setelah deploy terakhir (dikelola admin, tabel guide_articles): sama, seo.php?guide=.
  # Artikel yang sudah diprerender tertangkap aturan prerender lebih dulu. Batas 120 = batas slug guides.php/js.
  RewriteCond %{HTTP_HOST} ^garudanexa\.com$ [NC]
  RewriteRule ^panduan/([a-z0-9-]{1,120})$ seo.php?guide=$1 [L]

  # Rute aplikasi (akun, checkout, login, demo, pratinjau situs, admin) → cangkang SPA dengan robots noindex,follow.
  # ^pesan(/…)? tidak menangkap /pesan-custom (halaman publik yang diprerender).
  RewriteCond %{HTTP_HOST} ^garudanexa\.com$ [NC]
  RewriteRule ^(akun|admin|pesan|demo|situs|masuk|daftar|login|auth)(/.*)?$ app.html [L]

  # Domain pembeli (dan host lain): aplikasi satu halaman seperti sebelumnya, rute yang bukan file/folder → index.html
  RewriteCond %{HTTP_HOST} !^garudanexa\.com$ [NC]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]

  # Host utama: selebihnya 404 dari seo.php (isi 404.html), bukan R=404 + ErrorDocument (lihat aturan file internal
  # di atas). Query asli dibuang (?gn404=1 menggantikannya), jadi /x?slug=… tidak pernah merender template.
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ seo.php?gn404=1 [L]
</IfModule>

# Halaman 404 hasil prerender (noindex), cadangan untuk 404 dari server sendiri. 404 dari aturan di atas, seo.php dan
# api.php ditulis PHP.
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(self), geolocation=()"
  Header always set Strict-Transport-Security "max-age=31536000" env=HTTPS

  # Semua HTML (index.html, _pre/*.html, app.html, 404.html) selalu dicek ulang; file build bernama hash boleh
  # disimpan lama
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Cangkang aplikasi & halaman 404 tidak pernah diindeks (meta robots di HTML-nya juga noindex)
  <FilesMatch "^(app|404)\.html$">
    Header set X-Robots-Tag "noindex, follow"
  </FilesMatch>
  # File build Vite bernama hash (assets/<nama>-<hash 8 karakter>.js/.css) tidak pernah berubah isinya:
  # simpan setahun tanpa dicek ulang. Nama baru = isi baru, jadi tidak ada versi basi.
  <FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  # LiteSpeed menyajikan .js sebagai text/javascript; application/javascript tetap untuk server lain
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  # Nama video hero acak per unggahan (hero_video_<hex>), jadi boleh disimpan lama
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
</IfModule>

# Batas upload untuk api.php (gambar & dokumen dikirim base64, video hero sebagai body mentah:
# UPLOAD_MAX_VIDEO_MB di .env harus di bawah post_max_size)
<IfModule mod_php.c>
  php_value post_max_size 64M
  php_value upload_max_filesize 32M
  php_value memory_limit 256M
</IfModule>

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “ea-php84” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php84 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

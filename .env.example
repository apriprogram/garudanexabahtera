# Copy this file to .env (same folder as docker-compose.yml) and fill in real values:
#   cp .env.example .env
# .env is gitignored — never commit it. docker compose and backup.sh read it automatically.

# ── MySQL ──
# Root password of the mysql container. The api service connects with it as MYSQL_PASS.
# Note: MYSQL_ROOT_PASSWORD is only applied when the mysql_data volume is first created.
# To change it on an existing database, run ALTER USER inside MySQL first, then update it here.
MYSQL_ROOT_PASSWORD=change-me
MYSQL_DB=db_garudanexabahtera

# ── S3 storage (CloudHost IS3) ──
S3_ENDPOINT=https://is3.cloudhost.id
S3_REGION=us-east-1
S3_BUCKET=garudanexa
S3_PUBLIC_URL=https://is3.cloudhost.id/garudanexa
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# ── OpenAI (optional) ──
OPENAI_API_KEY=

# ── Admin login / API security (backend/server.js and backend/api.php) ──
# Signs the login tokens. REQUIRED, at least 32 random characters, different per environment:
#   openssl rand -hex 32
# Changing it logs every admin out.
AUTH_SECRET=
# How long a login stays valid, in seconds (default 8 hours)
AUTH_TOKEN_TTL=28800
# Extra browser origins allowed to call the API (comma separated). The website itself is
# same-origin and needs nothing here; leave empty unless another site must call the API.
CORS_ORIGINS=
# Number of reverse proxies in front of the Node API (nginx container = 1; add 1 for a host proxy
# such as another nginx/Caddy/Cloudflare). Used for the client IP in the login rate limit.
TRUST_PROXY=1
# Upload limits in MB
UPLOAD_MAX_IMAGE_MB=10
UPLOAD_MAX_FILE_MB=25
# Hero background video (admin → Pengaturan website → Hero, MP4/WebM). Keep it below nginx client_max_body_size
# (64m) and, on cPanel, below post_max_size (64M in deploy/cpanel/htaccess)
UPLOAD_MAX_VIDEO_MB=30

# ── Akun login produk klien (kolom list_products.users) ──
# Kunci AES-256-GCM untuk mengenkripsi username/password produk klien di database. backend/server.js dan
# backend/api.php memakai kunci yang sama. Tanpa kunci ini akun produk tidak bisa dibaca atau disimpan
# (daftar produk publik tetap jalan). 64 karakter hex, buat sekali per server dan JANGAN di-commit:
#   openssl rand -hex 32
# Simpan cadangannya di tempat aman (password manager): kalau kunci hilang atau diganti, akun yang sudah
# terenkripsi tidak bisa dibuka lagi. Setelah mengisi kunci, jalankan sekali aksi admin
# encrypt_list_products untuk mengenkripsi baris lama (lihat database/README.md).
LIST_PRODUCTS_KEY=

# ── Pembayaran template: Midtrans Snap (backend/server.js dan backend/api.php) ──
# Server key dari dashboard Midtrans (Settings > Access Keys). RAHASIA, jangan di-commit.
# Kosong = pesanan tetap dibuat, tetapi tanpa link bayar ("Pembayaran online belum dikonfigurasi.").
MIDTRANS_SERVER_KEY=
# Client key dari dashboard Midtrans (boleh terlihat di browser)
MIDTRANS_CLIENT_KEY=
# 0 = sandbox (uji coba), 1 = produksi (uang sungguhan)
MIDTRANS_IS_PRODUCTION=0
# 1 = tombol "simulasi bayar" untuk uji lokal tanpa Midtrans (hanya berlaku bila MIDTRANS_IS_PRODUCTION=0).
# Selalu 0 di server produksi.
MIDTRANS_SIMULATOR=0
# Alamat website tanpa garis miring di akhir, untuk kembali dari halaman bayar Midtrans
# (mis. http://localhost:5173 lokal, https://garudanexa.com produksi).
# Set juga Payment Notification URL di dashboard Midtrans ke: <APP_URL>/api.php?action=midtrans_notification
APP_URL=

# ── Masuk & daftar pembeli dengan Google (docs/platform/GOOGLE-LOGIN.md) ──
# Client ID OAuth "Web application" dari Google Cloud Console (bukan rahasia; client secret TIDAK dipakai).
# Authorized JavaScript origins: https://garudanexa.com, http://localhost:5173, http://localhost.
# Setting hero_settings.google_client_id (bila terisi) didahulukan. Kosong keduanya = tombol Google disembunyikan.
GOOGLE_CLIENT_ID=

# ── Domain: DewaBiz (registrar reseller, https://docs.dewabiz.co.id/developer/api) ──
# Cek ketersediaan domain + daftar ekstensi & harga beli (harga jual = harga tetap .com/.id/.my.id/.web.id, ekstensi lain
# harga beli + markup "domain_markup_percent" di admin > Pengaturan website > Harga). Reseller ID + API key dari dashboard
# DewaBiz > Settings > API & Modules; daftarkan IP server (dan IP lokal untuk uji) di whitelist API key. RAHASIA.
# Kosong = cek lewat RDAP registri dan tabel harga bawaan (backend/modules/domains.php).
DEWABIZ_RESELLER_ID=
DEWABIZ_API_KEY=
# DEWABIZ_API_URL=https://api.dewabiz.co.id/v1

# ── Dokumen proyek: file privat (tanda tangan elektronik, bukti bayar) ──
# Folder di luar web root untuk backend/server.js. Kosong = <repo>/storage/project-docs (dev lokal); Docker mengisinya
# lewat docker-compose.yml (/data/project-docs di volume pd_storage). api.php selalu memakai
# <folder induk web root>/storage/project-docs (cPanel: di luar public_html).
PD_STORAGE_DIR=

# ── Nexa AI: chat publik di beranda (opsional; backend/modules/nexa.php & nexa.js) ──
# Kunci API Anthropic (platform.claude.com). Kosong = Nexa menjawab dari data situs saja, tanpa AI.
ANTHROPIC_API_KEY=
# Model Claude (bawaan claude-opus-5-5), batas pertanyaan per hari untuk semua pengunjung (bawaan 1000),
# dan path llms-full.txt bila tidak ada di web root (dev lokal; produksi memakai <web root>/llms-full.txt).
# Batas pertanyaan per pengunjung memakai IP klien: di belakang Cloudflare pastikan server melihat IP pengunjung asli
# (LiteSpeed/Apache memulihkan CF-Connecting-IP, atau TRUST_PROXY=1), bukan IP Cloudflare.
NEXA_MODEL=
NEXA_DAILY_LIMIT=
NEXA_KNOWLEDGE_FILE=
# Penyedia kedua: Google Gemini (aistudio.google.com). Kunci juga bisa diisi admin lewat tab Tanya Nexa di
# Pengaturan website (tersimpan di database; kunci di tab itu menang atas .env). Model bawaan gemini-3.5-flash,
# cadangan otomatis gemini-flash-latest bila model utama dipensiunkan/padat.
GEMINI_API_KEY=
NEXA_GEMINI_MODEL=

# ── Bot WhatsApp lewat WAHA (docs/platform/WHATSAPP-BOT-SPEC.md; backend/modules/waha.php & waha.js) ──
# Pesan klien ke nomor WhatsApp bisnis dijawab Nexa AI (penyedia tab Tanya Nexa); klien yang minta admin, atau AI yang
# mati/gagal, dialihkan ke nomor WA admin. Webhook: <APP_URL>/api.php?action=waha_webhook, events message + message.any.
# Kunci HMAC webhook (X-Webhook-Hmac, sha512), sama dengan config.webhooks[].hmac.key session WAHA. WAJIB untuk bot;
# RAHASIA, hanya di .env (kosong = webhook menolak semua pesan dengan 503).
WAHA_HMAC_KEY=
# Alamat WAHA (mis. https://waha.contoh.com), X-Api-Key WAHA (hanya dikirim ke server WAHA_URL), nama session (bawaan
# default), dan nomor WA admin penerima notifikasi "klien butuh admin" (mis. 6281234567890). Semuanya bisa juga diisi
# admin di tab Tanya Nexa (isian admin menang).
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=
WAHA_ADMIN_NUMBER=
# Jawaban AI per hari untuk semua chat WhatsApp (pengaman biaya), bawaan 500; lewat batas → chat dialihkan ke admin
WAHA_DAILY_LIMIT=
